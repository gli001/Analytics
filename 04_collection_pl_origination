    SELECT 
        fadp.LoanID,
        fadp.ExternalApplicationDecisionID
    FROM {{ source('edw', 'fact_application_decision_pl') }} AS fadp
    WHERE fadp.LoanID IN (SELECT bd.LoanID FROM {{ ref('collection_pl_post_dq_pop_v2') }} AS bd)
),
